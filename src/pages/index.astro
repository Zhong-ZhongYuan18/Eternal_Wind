---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { architectureProjects, photographyProjects, researchProjects } from '../data/projects.js';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="ZhongZhongYuan — Architecture, Photography & Research" description="Selected architecture projects, photography and academic research by ZhongZhongYuan.">
  <section class="intro wrap">
    <div><span class="eyebrow">ARCHITECTURE DESIGNER & RESEARCHER</span><h1>Designing spaces.<br/>Reading places.<br/>Seeing differently.</h1></div>
    <p class="intro-copy">I explore the relationship between architecture, people and place through spatial design, visual storytelling and academic research. This portfolio brings together selected projects, images and investigations.</p>
  </section>
  <section class="wrap home-section">
    <div class="section-head"><h2>Selected Architecture</h2><span>01 — 03 / <a class="text-link" href={`${base}architecture/`}>VIEW ALL ↗</a></span></div>
    <div class="project-grid">{architectureProjects.slice(0,2).map((project,i)=><ProjectCard project={project} index={i+1}/>)}</div>
  </section>
  <section class="wrap home-section">
    <div class="section-head"><h2>Photography</h2><span>VISUAL ARCHIVE / <a class="text-link" href={`${base}photography/`}>EXPLORE ↗</a></span></div>
    <div class="photo-grid home-photo-grid">
      {photographyProjects.slice(0,3).map((photo)=><a class="photo-item" href={`${base}photography/`}><img src={photo.image} alt={photo.title} loading="lazy"/><div class="photo-caption"><span>{photo.title}</span><span>{photo.year}</span></div></a>)}
    </div>
  </section>
  <section class="wrap home-section">
    <div class="section-head"><h2>Research & Inquiry</h2><span>SELECTED STUDIES / <a class="text-link" href={`${base}research/`}>READ MORE ↗</a></span></div>
    <div class="three-column">
      {researchProjects.slice(0,3).map((item,i)=><article class="discipline"><span class="number">0{i+1} / {item.year}</span><h3>{item.title}</h3><p>{item.summary}</p><span class="eyebrow">{item.type}</span></article>)}
    </div>
  </section>
</BaseLayout>
