---
const { project, index = 1 } = Astro.props;
---
<a class="project-card" href={`${import.meta.env.BASE_URL}architecture/${project.slug}/`}>
  <div class="card-image"><img src={project.cover} alt={`Project view: ${project.title}`} loading="lazy" /><span class="image-index">{String(index).padStart(2, '0')}</span><span class="card-arrow">↗</span></div>
  <div class="card-meta"><div><h3>{project.title}</h3><p>{project.category}</p></div><span>{project.year}</span></div>
</a>
